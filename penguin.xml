<?xml version="1.0" encoding="UTF-8"?>
<!-- Motorola Moto G54 5G (cancunf) for PenguinOS celerity (Android 17, CLO/AOSPA base).
     Save as .repo/local_manifests/cancunf.xml, then repo sync. See README.md on the clo branch. -->
<manifest>
  <remote name="zoro" fetch="https://github.com/Zoro-15" />
  <remote name="sarthak" fetch="https://github.com/sarthakroy2002" />
  <remote name="yaap" fetch="https://github.com/YAAP" />
  <remote name="cyberknight777" fetch="https://github.com/cyberknight777" />
  <remote name="lineage" fetch="https://github.com/LineageOS" />

  <!-- Device tree: Zoro-15 clo branch with full AOSPA/CLO adaptations -->
  <project path="device/motorola/cancunf" name="device_motorola_cancunf" remote="zoro" revision="clo" />

  <!-- Prebuilt Kernel: Sarthak Roy seventeen branch (pinned to pre-ARB update commit 741572a) -->
  <project path="device/motorola/cancunf-kernel" name="device_motorola_cancunf-kernel" remote="sarthak" revision="741572ae68a88539c38486a74ca4bbb48c2e0da6" />

  <!-- Vendor blobs: Sarthak Roy seventeen branch on GitHub (pinned to pre-ARB update commit 603b93f) -->
  <project path="vendor/motorola/cancunf" name="vendor_motorola_cancunf" remote="sarthak" revision="603b93ff7a89a144e6c7d4f29cc32c8df322879e" />
  <project path="vendor/motorola/cancunf-motcamera" name="vendor_motorola_cancunf-motcamera" remote="yaap" revision="seventeen" />

  <!-- MediaTek HAL and sepolicy -->
  <project path="hardware/mediatek" name="hardware_mediatek" remote="yaap" revision="seventeen" />
  <project path="device/mediatek/sepolicy_vndr" name="device_mediatek_sepolicy_vndr" remote="yaap" revision="seventeen" />

  <!-- Features -->
  <remove-project name="Project-PenguinOS/android_vendor_addons" />
  <project path="packages/apps/DisplayFeatures" name="android_packages_apps_DisplayFeatures" remote="cyberknight777" revision="master" />

  <!-- Lineage & Pixel HAL interfaces required by cancunf touch, power-libperfmgr, and MediaTek sepolicy -->
  <project path="hardware/lineage/interfaces" name="android_hardware_lineage_interfaces" remote="lineage" revision="lineage-24.0" />
  <project path="hardware/google/pixel" name="android_hardware_google_pixel" remote="lineage" revision="lineage-24.0" />
  <project path="device/lineage/sepolicy" name="android_device_lineage_sepolicy" remote="lineage" revision="lineage-24.0" />
</manifest>
